# =================================================================
# Intelligence Driven Masking - Environment Configuration Template
# Copy this file to .env.local for local development
# cp .env.example .env.local
# =================================================================

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# ── Database: MongoDB ────────────────────────────────────────────
# Leave empty to use in-memory fallback store (no MongoDB required for local dev)
MONGODB_URI=
# Example: MONGODB_URI=mongodb://localhost:27017/intelligence_mask
# Example: MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/intelligence_mask

# ── Cache: Redis ─────────────────────────────────────────────────
# Leave empty to use in-memory rate limiter fallback (no Redis required for local dev)
REDIS_URL=
# Example: REDIS_URL=redis://localhost:6379
# Example: REDIS_URL=rediss://user:password@redis-host:6380

# ── API Security ─────────────────────────────────────────────────
# Secret used for signing JWT sessions (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-in-production-32-chars-minimum

# ── Enterprise API Keys (Demo) ───────────────────────────────────
# These are pre-seeded demo keys for local testing
DEMO_API_KEY=sk_live_enterprise_demo_948210392810

# ── Detection Engine Configuration ───────────────────────────────
# Maximum characters per prompt (default: 100000)
MAX_PROMPT_LENGTH=100000
# Default masking strategy if not specified: REPLACE | REDACT | HASH | PSEUDONYMIZE
DEFAULT_MASKING_STRATEGY=REPLACE
# Minimum confidence score threshold (0.0 - 1.0) to trigger masking
MIN_CONFIDENCE_THRESHOLD=0.85

# ── Rate Limiting ────────────────────────────────────────────────
# Default rate limit (requests per minute per API key)
RATE_LIMIT_PER_MINUTE=500
# Demo key rate limit (lower for unauthenticated access)
RATE_LIMIT_DEMO_PER_MINUTE=60

# ── Audit Log Settings ───────────────────────────────────────────
# Maximum audit log entries in memory store
MAX_AUDIT_LOG_ENTRIES=500
# Number of characters of prompt to store in audit snippet
AUDIT_SNIPPET_LENGTH=120

# ── Telemetry & Observability ─────────────────────────────────────
# Optional: Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/yyy

# ── Compliance & Compliance Mode ─────────────────────────────────
# HIPAA mode forces PSEUDONYMIZE strategy for MEDICAL_RECORD entities
# HIPAA_MODE=true
# GDPR mode enables EU-specific data handling rules
# GDPR_MODE=true
